# ─── Frontend (Vite — these are bundled into the client) ───────────────
VITE_INSFORGE_URL=https://your-app.region.insforge.app
VITE_INSFORGE_ANON_KEY=your_insforge_anon_key

# Cloudflare RealtimeKit credentials are server-side only (see the edge
# function secrets below). Never add them as VITE_ variables: anything prefixed
# VITE_ is compiled into the public JavaScript bundle.

# Paystack — PUBLIC key only. The secret key must never appear here.
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key


# ─── Netlify Functions (server-side only, never bundled) ───────────────
# Direct Postgres connection used by netlify/functions/library_api
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Used by netlify/functions/feeds_api and netlify/edge-functions/share
INSFORGE_URL=https://your-app.region.insforge.app
INSFORGE_ANON_KEY=your_insforge_anon_key


# ─── InsForge Edge Function secrets (set via `insforge secrets add`) ───
# Never place these in this file for a deployed environment.
# PAYSTACK_SECRET_KEY=sk_live_xxx
# INSFORGE_BASE_URL=https://your-app.region.insforge.app
# API_KEY=your_service_role_edge_function_token
# SMTP_PASSWORD=your_smtp_app_password
# BUNNY_API_KEY=your_bunnycdn_api_key
# BUNNY_LIBRARY_ID=your_bunny_video_library_id
# BUNNY_PULL_ZONE=your-zone.b-cdn.net
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_APP_ID=your_realtimekit_app_id
# CLOUDFLARE_API_TOKEN=your_realtimekit_api_token
