# ─── Frontend (Vite — these are bundled into the client) ───────────────
VITE_INSFORGE_URL=https://your-app.region.insforge.app
VITE_INSFORGE_ANON_KEY=your_insforge_anon_key

# Optional. Where edge functions are served from. Leave unset and the app
# derives {appKey}.function2.insforge.app from the URL above, which is what
# `GET /api/functions` reports as deploymentUrl. Set this only if a project
# serves functions from somewhere else — check deploymentUrl before guessing,
# since a wrong host surfaces as "Failed to fetch", not as a 404.
# VITE_INSFORGE_FUNCTIONS_URL=https://your-app.function2.insforge.app

# Cloudflare RealtimeKit credentials are server-side only (see the edge
# function secrets below). Never add them as VITE_ variables: anything prefixed
# VITE_ is compiled into the public JavaScript bundle.

# Paystack — PUBLIC key only. The secret key must never appear here.
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key


# ─── Hosting platform (server-side only, never bundled) ────────────────
# The public origin the deployed site is served from. Used by edge functions
# for links in outgoing email.
SITE_URL=https://your-deployed-site


# ─── InsForge Edge Function secrets (set via `insforge secrets add`) ───
# Never place these in this file for a deployed environment.
# PAYSTACK_SECRET_KEY=sk_live_xxx
# INSFORGE_BASE_URL=https://your-app.region.insforge.app
# API_KEY=your_service_role_edge_function_token
# SMTP_PASSWORD=your_smtp_app_password
# Bunny Stream. BUNNY_API_KEY is the VIDEO LIBRARY key (Stream API), not the
# account-level key — the account key returns 401 against video.bunnycdn.com.
# Find it on the library's API page, or as ApiKey in GET /videolibrary/{id}.
# BUNNY_API_KEY=your_video_library_api_key
# BUNNY_LIBRARY_ID=your_bunny_video_library_id
# BUNNY_PULL_ZONE=vz-xxxxxxxx-xxx.b-cdn.net
#
# The pull zone's token authentication key — a THIRD value, distinct from both
# keys above (ZoneSecurityKey in GET /pullzone/{id}). Signed playback URLs are
# validated against this; signing with BUNNY_API_KEY yields 403 on every video.
# BUNNY_TOKEN_KEY=your_pull_zone_token_authentication_key
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_APP_ID=your_realtimekit_app_id
# CLOUDFLARE_API_TOKEN=your_realtimekit_api_token
